  "components": {
    "schemas": {
      "BookingItemRequestDTO": {
        "type": "object",
        "properties": {
          "petId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "scheduledStartAt": {
            "type": "string",
            "format": "date-time"
          },
          "scheduledEndAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "format": "double"
          },
          "roomId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "staffId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookingItemStatus": {
        "enum": [
          "Pending",
          "Confirmed",
          "Checked_In",
          "In_Progress",
          "Completed",
          "Cancelled",
          "No_Show"
        ],
        "type": "string"
      },
      "CancelBookingCommand": {
        "type": "object",
        "properties": {
          "cancellationReason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateBookingCommand": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "promotionCode": {
            "type": "string",
            "nullable": true
          },
          "bookingItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemRequestDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateServiceCommand": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "serviceType": {
            "$ref": "#/components/schemas/ServiceType"
          },
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServicePriceDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PricingUnit": {
        "enum": [
          "Per_Turn",
          "Per_Day",
          "Item"
        ],
        "type": "string"
      },
      "ServicePriceDTO": {
        "type": "object",
        "properties": {
          "minWeight": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxWeight": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "pricingUnit": {
            "$ref": "#/components/schemas/PricingUnit"
          }
        },
        "additionalProperties": false
      },
      "ServiceType": {
        "enum": [
          "Grooming",
          "Boarding",
          "Diet",
          "Care"
        ],
        "type": "string"
      },
      "UpdateBookingItemStatusCommand": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/BookingItemStatus"
          },
          "resultNote": {
            "type": "string",
            "nullable": true
          },
          "resultImageUrl": {
            "type": "string",
            "nullable": true
          },
          "staffId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "roomId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateServiceCommand": {
        "type": "object",
